{
  "$description": "EAI design tokens. Source of truth. Colour and type are mirrored in ../colors_and_type.css; space, radius, shadow and layout in tokens.css. Owner: design. Defaults follow marketing/ where the prototypes disagree; see Open decisions in ../../../readme.md.",
  "color": {
    "$type": "color",
    "brand": {
      "navy": { "$value": "#0d3857", "$description": "Logo mark and wordmark. Primary brand colour. DECIDE #7." },
      "cyan": { "$value": "#8edff9", "$description": "The dot in the logo. Accent." },
      "blue": { "$value": "#1c84e0", "$description": "DECIDE #7. Only used in mkt-site.css. Default: dropped.", "$extensions": { "eai.status": "DECIDE" } }
    },
    "neutral": {
      "$description": "DECIDE #8. Default: cool zinc (marketing.css).",
      "bg": { "$value": "#ffffff" },
      "surface": { "$value": "#fcfcfc" },
      "border": { "$value": "#e4e4e7" },
      "text": { "$value": "#202020" },
      "text-muted": { "$value": "#646464" }
    },
    "neutral-warm": {
      "$description": "Alternative from mkt-site.css. Not used unless DECIDE #8 goes warm.",
      "ink": { "$value": "#26251e" },
      "surface": { "$value": "#f7f7f3" },
      "tile": { "$value": "#f1f0ee" },
      "muted": { "$value": "#696c74" },
      "border": { "$value": "#ebebeb" }
    },
    "action": {
      "cta-bg": { "$value": "#18181b", "$description": "Primary buttons." },
      "cta-text": { "$value": "#fafafa" }
    },
    "status": {
      "$description": "TODO: success, warning, danger, info.",
      "success": { "$value": "TODO" },
      "warning": { "$value": "TODO" },
      "danger": { "$value": "TODO" }
    }
  },
  "font": {
    "$description": "DECIDE #9. Default: Inter stack (marketing.css). Alternative: Geist + Geist Mono.",
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
      "display": { "$value": ["Inter Tight", "Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "$description": "12 to 24 are observed on the site. 32 and up are TODO: the hero sizes weren't captured.",
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "base": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "24px" },
      "2xl": { "$value": "32px", "$extensions": { "eai.status": "TODO" } },
      "3xl": { "$value": "48px", "$extensions": { "eai.status": "TODO" } },
      "display": { "$value": "64px", "$extensions": { "eai.status": "TODO" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-0.03em" },
      "heading": { "$value": "-0.02em" },
      "eyebrow": { "$value": "0.08em" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "8px", "$description": "Most common on the site." },
    "lg": { "$value": "12px" },
    "xl": { "$value": "16px" },
    "full": { "$value": "999px", "$description": "Pills and chips." }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 2px rgba(16, 24, 40, 0.05)" },
    "md": { "$value": "0 8px 24px rgba(9, 9, 11, 0.06)" },
    "lg": { "$value": "0 24px 48px rgba(0, 0, 0, 0.16)" }
  },
  "space": {
    "$type": "dimension",
    "$description": "Proposed 4px scale. The site doesn't have one yet.",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "24": { "$value": "96px" }
  },
  "layout": {
    "$type": "dimension",
    "max-width": { "$value": "1160px" }
  }
}
