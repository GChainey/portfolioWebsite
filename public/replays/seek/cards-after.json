or: var(--navy-deep); }.disc { width: 32px; height: 32px; border-radius: 50%; background: var(--navy); display: grid; grid-template-columns: repeat(3, 3px); gap: 3px; place-content: center; }.disc i { width: 3px; height: 3px; border-radius: 50%; background: rgb(255, 255, 255); opacity: 0.85; }.disc i:nth-child(1), .disc i:nth-child(3), .disc i:nth-child(7), .disc i:nth-child(9) { opacity: 0.35; }.bar-end { display: flex; align-items: center; gap: 18px; }.link { color: var(--blue); }.bar .link { font-size: 16px; }.menu { fill: var(--body); }.module { padding: 28px 16px 40px; }.module h1 { font: 600 22px / 28px Inter, sans-serif; letter-spacing: -0.01em; color: var(--ink); }.tabs { display: flex; gap: 20px; margin-top: 14px; border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }.tabs::-webkit-scrollbar { display: none; }.tab { position: relative; flex: 0 0 auto; padding: 6px 0px 10px; font-size: 16px; color: var(--muted); transition: color 150ms; }.tab::after { content: \"\"; position: absolute; left: 0px; right: 0px; bottom: -1px; height: 3px; border-radius: 2px; background: var(--blue); transform: scaleX(0); transition: transform 200ms var(--ease-out); }.tab[aria-selected=\"true\"] { color: var(--blue); }.tab[aria-selected=\"true\"]::after { transform: scaleX(1); }.field-label { display: block; margin-top: 24px; font: 600 14px / 20px Inter, sans-serif; color: var(--ink); }.select { margin-top: 8px; height: 46px; display: flex; align-items: center; gap: 10px; padding: 0px 14px; border: 2px solid var(--field); border-radius: 8px; color: var(--ink); font-size: 16px; }.select .chev { margin-left: auto; }.group { margin-top: 32px; scroll-margin-top: 12px; }.group h2 { font: 600 18px / 24px Inter, sans-serif; color: var(--ink); }.group h2.under { text-decoration: underline 1.5px; text-underline-offset: 4px; }.group > p { margin-top: 8px; font-size: 15px; }.fade { transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out); }.fade.pre { opacity: 0; transform: translateY(8px); }.fade.pre.from-right { transform: translateX(16px); }.fade.pre.pop { transform: scale(0.97); }.rail { display: flex; gap: 12px; margin: 16px -16px 0px; padding: 0px 16px 2px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 16px; scrollbar-width: none; }.rail::-webkit-scrollbar { display: none; }.card { flex: 0 0 auto; width: 282px; scroll-snap-align: start; border: 1px solid var(--card-line); border-radius: 16px; padding: 20px; text-align: left; background: rgb(255, 255, 255); transition: transform 150ms var(--ease-out), border-color 150ms ease; }.card:active { transform: scale(0.98); }.card .mark { width: 40px; height: 40px; border-radius: 8px; display: grid; place-items: center; background: var(--panel); margin-bottom: 14px; }.card h3 { font: 600 17px / 23px Inter, sans-serif; color: var(--ink); }.card .by { color: var(--muted); margin-top: 2px; }.card .old-title { font: 600 15px / 21px Inter, sans-serif; color: var(--ink); }.card .partner { color: var(--muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.card .facts { margin-top: 14px; display: grid; gap: 2px; font-size: 15px; }.dots { display: flex; justify-content: center; gap: 8px; margin-top: 14px; }.dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--card-line); transition: background-color 200ms; }.dots i.on { background: var(--body); }.mark { box-shadow: inset 0 0 0 1px var(--line); overflow: hidden; background: rgb(255, 255, 255) !important; }.mark img { display: block; max-width: 76%; max-height: 76%; object-fit: contain; }.mark.fill { box-shadow: none; }.mark.fill img { width: 100%; height: 100%; max-width: none; max-height: none; object-fit: cover; }.btn { height: 48px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font: 600 16px / 1 Inter, sans-serif; transition: transform 150ms var(--ease-out); }.btn:active { transform: scale(0.