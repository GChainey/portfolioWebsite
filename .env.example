# GitHub Personal Access Token for contribution count
# Create at: https://github.com/settings/tokens
# No special scopes needed (public data only)
GITHUB_TOKEN=

# AI chat (production): Anthropic key + Upstash Redis for the monthly spend cap and rate limit
ANTHROPIC_API_KEY=
# Monthly spend cap in USD (default 10); chat pauses once reached
CHAT_MONTHLY_CAP_USD=10
# Provisioned via Vercel Marketplace > Upstash Redis (KV_REST_API_* also accepted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local dev uses Groq (free tier)
GROQ_API_KEY=
